<a href="{{ card_product.url }}" class="pcard">
<div class="pcard-media">{% if card_product.featured_image %}<img src="{{ card_product.featured_image | image_url: width: 600 }}" alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}" loading="lazy">{% else %}<div class="pcard-ph">A&amp;O</div>{% endif %}
<div class="pcard-badges">{% if card_product.tags contains 'Bestseller' %}<span class="badge badge-dark">Bestseller</span>{% endif %}{% if card_product.tags contains 'New' %}<span class="badge">New</span>{% endif %}{% if card_product.compare_at_price > card_product.price %}<span class="badge badge-sale">Sale</span>{% endif %}</div>
{% if card_product.available %}<div class="pcard-quick"><button type="button" class="btn btn-light" data-add-to-cart="{{ card_product.selected_or_first_available_variant.id }}">Quick add</button></div>{% endif %}</div>
<div class="pcard-vendor">{{ card_product.vendor }}</div><h3 class="pcard-title">{{ card_product.title }}</h3>
<div class="pcard-price">{% if card_product.compare_at_price > card_product.price %}<span class="price-sale">{{ card_product.price | money }}</span><span class="price-compare">{{ card_product.compare_at_price | money }}</span>{% else %}<span>{{ card_product.price | money }}</span>{% endif %}</div>
{% assign rating = card_product.metafields.aura.rating.value %}{% if rating and rating.average %}<div class="pcard-stars">{% render 'stars', rating: rating.average %} <span>{{ rating.count }}</span></div>{% endif %}</a>