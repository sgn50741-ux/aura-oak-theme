<section class="section">
  <div class="container">
    <div class="sustainability-intro reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="lead">{{ section.settings.intro }}</p>
    </div>
    
    <div class="stats-grid reveal">
      {%- for i in (1..4) -%}
        {%- assign num_key = 'stat_number_' | append: i -%}
        {%- assign label_key = 'stat_label_' | append: i -%}
        {%- assign num = section.settings[num_key] -%}
        {%- assign label = section.settings[label_key] -%}
        {%- if num != blank -%}
          <div class="stat-card">
            <div class="stat-number">{{ num }}</div>
            <div class="stat-label">{{ label }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <div class="commitments reveal">
      {%- for i in (1..3) -%}
        {%- assign title_key = 'commitment_title_' | append: i -%}
        {%- assign text_key = 'commitment_text_' | append: i -%}
        {%- assign title = section.settings[title_key] -%}
        {%- assign text = section.settings[text_key] -%}
        {%- if title != blank -%}
          <div class="commitment-card">
            <h3>{{ title }}</h3>
            <p>{{ text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sustainability",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Commitment" },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "text", "id": "stat_number_1", "label": "Stat 1 number", "default": "100%" },
    { "type": "text", "id": "stat_label_1", "label": "Stat 1 label", "default": "Soy wax" },
    { "type": "text", "id": "stat_number_2", "label": "Stat 2 number", "default": "0" },
    { "type": "text", "id": "stat_label_2", "label": "Stat 2 label", "default": "Phthalates" },
    { "type": "text", "id": "stat_number_3", "label": "Stat 3 number", "default": "85%" },
    { "type": "text", "id": "stat_label_3", "label": "Stat 3 label", "default": "Recyclable packaging" },
    { "type": "text", "id": "stat_number_4", "label": "Stat 4 number", "default": "Carbon" },
    { "type": "text", "id": "stat_label_4", "label": "Stat 4 label", "default": "Neutral shipping" },
    { "type": "text", "id": "commitment_title_1", "label": "Commitment 1 title", "default": "Clean Ingredients" },
    { "type": "textarea", "id": "commitment_text_1", "label": "Commitment 1 text" },
    { "type": "text", "id": "commitment_title_2", "label": "Commitment 2 title", "default": "Refillable Design" },
    { "type": "textarea", "id": "commitment_text_2", "label": "Commitment 2 text" },
    { "type": "text", "id": "commitment_title_3", "label": "Commitment 3 title", "default": "Local Production" },
    { "type": "textarea", "id": "commitment_text_3", "label": "Commitment 3 text" }
  ],
  "presets": [{ "name": "Sustainability" }]
}
{% endschema %}