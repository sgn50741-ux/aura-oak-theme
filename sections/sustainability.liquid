<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Our commitment</span>
      <h2>Made with care, for the planet.</h2>
    </div>
    
    <div class="sustainability-stats stagger">
      <div class="stat">
        <div class="stat-number">100%</div>
        <div class="stat-label">Soy wax</div>
      </div>
      <div class="stat">
        <div class="stat-number">0</div>
        <div class="stat-label">Phthalates</div>
      </div>
      <div class="stat">
        <div class="stat-number">85%</div>
        <div class="stat-label">Recyclable packaging</div>
      </div>
      <div class="stat">
        <div class="stat-number">100%</div>
        <div class="stat-label">Refillable vessels</div>
      </div>
    </div>
    
    <div class="commitment-grid stagger">
      <div class="commitment-card">
        <h4>Clean ingredients</h4>
        <p>We use 100% soy wax, cotton wicks, and phthalate-free fragrance oils. No paraffin, no synthetic dyes, no harmful chemicals.</p>
      </div>
      <div class="commitment-card">
        <h4>Refillable systems</h4>
        <p>Our ceramic vessels are designed to be refilled. Send back your empty vessel and we'll refill it for you, or purchase a refill insert.</p>
      </div>
      <div class="commitment-card">
        <h4>Responsible packaging</h4>
        <p>All packaging is recyclable or compostable. We use recycled paper, soy-based inks, and minimal plastic.</p>
      </div>
      <div class="commitment-card">
        <h4>Local production</h4>
        <p>Every candle is hand-poured in our Portland studio, supporting local artisans and reducing our carbon footprint.</p>
      </div>
      <div class="commitment-card">
        <h4>Small batches</h4>
        <p>We pour in small batches to ensure quality and reduce waste. No overproduction, no excess inventory.</p>
      </div>
      <div class="commitment-card">
        <h4>Giving back</h4>
        <p>1% of sales goes to environmental nonprofits working to protect forests and clean waterways.</p>
      </div>
    </div>
  </div>
</section>

