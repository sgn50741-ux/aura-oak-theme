<section class="section">
  <div class="container">
    <div class="shipping-intro reveal">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    
    <div class="shipping-grid">
      <div class="shipping-info reveal">
        <h3>{{ section.settings.shipping_heading }}</h3>
        <div class="rte">{{ section.settings.shipping_text }}</div>
        
        <table class="shipping-table">
          <thead>
            <tr>
              <th>Method</th>
              <th>Delivery Time</th>
              <th>Cost</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'shipping_option' -%}
                <tr>
                  <td>{{ block.settings.method }}</td>
                  <td>{{ block.settings.time }}</td>
                  <td>{{ block.settings.cost }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      
      <div class="returns-info reveal delay-1">
        <h3>{{ section.settings.returns_heading }}</h3>
        <div class="rte">{{ section.settings.returns_text }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shipping & Returns",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & Returns" },
    { "type": "text", "id": "shipping_heading", "label": "Shipping heading", "default": "Shipping Information" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping text" },
    { "type": "text", "id": "returns_heading", "label": "Returns heading", "default": "Returns & Exchanges" },
    { "type": "richtext", "id": "returns_text", "label": "Returns text" }
  ],
  "blocks": [
    {
      "type": "shipping_option",
      "name": "Shipping Option",
      "settings": [
        { "type": "text", "id": "method", "label": "Method" },
        { "type": "text", "id": "time", "label": "Delivery Time" },
        { "type": "text", "id": "cost", "label": "Cost" }
      ]
    }
  ],
  "presets": [{ "name": "Shipping & Returns" }]
}
{% endschema %}