{
  "name": "Marquee",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Hand-poured in Portland ✦ Small batch ✦ 100% soy wax ✦ Clean burning ✦" }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}