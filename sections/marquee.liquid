    <span>{{ section.settings.text }} ✦ {{ section.settings.text }} ✦ {{ section.settings.text }} ✦ {{ section.settings.text }} ✦ </span>
    <span>{{ section.settings.text }} ✦ {{ section.settings.text }} ✦ {{ section.settings.text }} ✦ {{ section.settings.text }} ✦ </span>
  </div>
</section>

