<div class="marquee">
  <div class="marquee-track">
    {%- for i in (1..10) -%}
      <span class="marquee-item">{{ section.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Marquee",
  "settings": [
    { "type": "text", "id": "text", "label": "Marquee text", "default": "Hand-poured in Portland ✦ Small batch ✦ 100% soy wax ✦ Clean burning ✦ Phthalate-free" }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}