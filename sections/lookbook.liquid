<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Lookbook</span>
      <h2>Scenes from the studio.</h2>
    </div>
    
    <div class="lookbook-grid stagger">
      {%- for i in (1..6) -%}
        {%- assign img_key = 'image_url_' | append: i -%}
        {%- assign img = section.settings[img_key] -%}
        <div class="lookbook-item">
          {%- if img != blank -%}
            <img src="{{ img }}" alt="Lookbook image {{ i }}" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;background:var(--line);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-style:italic;color:var(--oak);opacity:.3">A&O</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "image_url_1", "label": "Image 1 URL" },
    { "type": "text", "id": "image_url_2", "label": "Image 2 URL" },
    { "type": "text", "id": "image_url_3", "label": "Image 3 URL" },
    { "type": "text", "id": "image_url_4", "label": "Image 4 URL" },
    { "type": "text", "id": "image_url_5", "label": "Image 5 URL" },
    { "type": "text", "id": "image_url_6", "label": "Image 6 URL" }
  ],
  "presets": [{ "name": "Lookbook" }]
}
{% endschema %}