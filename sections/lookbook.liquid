
<section class="lookbook">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="lookbook-grid">
      {%- for i in (1..6) -%}
        {%- assign img_key = 'image_url_' | append: i -%}
        {%- assign cap_key = 'caption_' | append: i -%}
        {%- assign sub_key = 'subtitle_' | append: i -%}
        {%- assign style_key = 'style_' | append: i -%}
        {%- assign img = section.settings[img_key] -%}
        {%- assign cap = section.settings[cap_key] -%}
        {%- assign sub = section.settings[sub_key] -%}
        {%- assign style = section.settings[style_key] -%}
        {%- if img != blank -%}
          <div class="lookbook-item lookbook-item--{{ style | default: 'half' }} reveal-scale">
            <img src="{{ img }}" alt="{{ cap | escape }}" loading="lazy">
            {%- if cap != blank -%}
              <div class="lookbook-caption"><h4>{{ cap }}</h4>{%- if sub != blank %}<p>{{ sub }}</p>{%- endif -%}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}{"name":"Lookbook","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Lookbook"},
{"type":"text","id":"heading","label":"Heading","default":"The spaces we live in."},
{"type":"textarea","id":"subheading","label":"Subheading","default":"A visual journal."},
{"type":"text","id":"image_url_1","label":"Image 1 URL"},{"type":"text","id":"caption_1","label":"Caption 1"},{"type":"text","id":"subtitle_1","label":"Subtitle 1"},
{"type":"select","id":"style_1","label":"Style 1","options":[{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"},{"value":"half","label":"Half"},{"value":"third","label":"Third"}],"default":"wide"},
{"type":"text","id":"image_url_2","label":"Image 2 URL"},{"type":"text","id":"caption_2","label":"Caption 2"},{"type":"text","id":"subtitle_2","label":"Subtitle 2"},
{"type":"select","id":"style_2","label":"Style 2","options":[{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"},{"value":"half","label":"Half"},{"value":"third","label":"Third"}],"default":"tall"},
{"type":"text","id":"image_url_3","label":"Image 3 URL"},{"type":"text","id":"caption_3","label":"Caption 3"},{"type":"text","id":"subtitle_3","label":"Subtitle 3"},
{"type":"select","id":"style_3","label":"Style 3","options":[{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"},{"value":"half","label":"Half"},{"value":"third","label":"Third"}],"default":"half"},
