<section class="section"><div class="container">
<div class="section-head reveal"><span class="eyebrow">Lookbook</span><h2>In the spaces where we slow down.</h2></div>
<div class="lookbook-grid stagger">{% for block in section.blocks %}<div class="lb-item {{ block.settings.size }}" {{ block.shopify_attributes }}>
{% if block.settings.image_url != blank %}<img src="{{ block.settings.image_url }}" alt="" loading="lazy">{% endif %}
{% if block.settings.caption != blank %}<div class="lb-cap">{{ block.settings.caption }}</div>{% endif %}</div>{% endfor %}</div>
</div></section>
{% schema %}{"name":"Lookbook","blocks":[{"type":"image","name":"Image","settings":[{"type":"text","id":"image_url","label":"Image URL"},{"type":"text","id":"caption","label":"Caption"},{"type":"select","id":"size","label":"Size","options":[{"value":"","label":"Standard"},{"value":"tall","label":"Tall"},{"value":"wide","label":"Wide"}]}]}],"presets":[{"name":"Lookbook"}]}{% endschema %}