<div class="container section">
  <div class="section-head reveal">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="tiles">
    {%- for collection in collections -%}
      {%- unless collection.title == 'All Products' or collection.title == 'Frontpage' -%}
        <a href="{{ collection.url }}" class="tile reveal">
          {%- if collection.image -%}
            <div class="tile-bg" style="background-image:url('{{ collection.image | image_url: width: 1200 }}')"></div>
          {%- else -%}
            <div class="tile-bg" style="background:linear-gradient(135deg,var(--cream-2),var(--line))"></div>
          {%- endif -%}
          <div class="tile-body">
            <span class="eyebrow">Collection</span>
            <h3>{{ collection.title }}</h3>
            <span class="tile-arrow">
              Explore
              <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "All collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Collections" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Browse our complete range." }
  ]
}
{% endschema %}
