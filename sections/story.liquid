<section class="section" style="background:var(--cream2)"><div class="container story">
<div class="story-media reveal">{% if section.settings.image_url != blank %}<img src="{{ section.settings.image_url }}" alt="" loading="lazy">{% endif %}</div>
<div class="story-content reveal delay-1"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="serif-h2">{{ section.settings.heading }}</h2><p>{{ section.settings.body }}</p>
<div class="story-values stagger">
<div class="value"><h4>100% soy wax</h4><p>Clean, renewable, and always phthalate-free.</p></div>
<div class="value"><h4>Hand-thrown vessels</h4><p>Made by ceramicists in small batches.</p></div>
<div class="value"><h4>Small-batch pouring</h4><p>Every candle poured by hand in Portland.</p></div>
<div class="value"><h4>Refillable systems</h4><p>Vessels designed to live on, endlessly.</p></div>
</div></div></div></section>
{% schema %}{"name":"Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our studio"},{"type":"text","id":"heading","label":"Heading","default":"Fragrance as a practice."},{"type":"textarea","id":"body","label":"Body","default":"We started Aura &amp; Oak in a converted garage in Portland with one candle — Amber &amp; Oakmoss — and a belief that the things we smell every day should be made with as much care as the things we eat."},{"type":"text","id":"image_url","label":"Image URL"}],"presets":[{"name":"Story"}]}{% endschema %}