<section class="section" style="background:var(--cream-2)">
  <div class="container story">
    <div class="story-media reveal">
      {%- if section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- elsif section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="story-content reveal delay-1">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
      <div class="story-values">
        <div class="value"><h4>100% soy wax</h4><p>Clean, renewable, and always phthalate-free.</p></div>
        <div class="value"><h4>Hand-thrown vessels</h4><p>Made by ceramicists in small batches.</p></div>
        <div class="value"><h4>Small-batch pouring</h4><p>Every candle poured by hand in Portland.</p></div>
        <div class="value"><h4>Refillable systems</h4><p>Vessels designed to live on, endlessly.</p></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fragrance as a practice." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "We started Aura & Oak in a converted garage in Portland with one candle — Amber & Oakmoss — and a belief that the things we smell every day should be made with as much care as the things we eat and the things we read. Seven years later, we're still a small studio, still pouring by hand, still obsessed with the way a scent can make a room feel like home." },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "image_url", "label": "Or paste image URL" }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}