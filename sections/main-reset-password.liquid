<div class="auth-wrap"><h1>Reset your password</h1><p class="subtitle">Enter a new password for your account.</p>
<div class="auth-card">{% form 'reset_customer_password' %}{{ form.errors | default_errors }}
<div class="field"><label>New password</label><input type="password" name="customer[password]" required></div>
<div class="field"><label>Confirm password</label><input type="password" name="customer[password_confirmation]" required></div>
<button type="submit" class="btn btn-primary btn-full">Reset password</button>{% endform %}</div></div>
{% schema %}{"name":"Reset password"}{% endschema %}