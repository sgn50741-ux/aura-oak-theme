<section class="section">
  <div class="container">
    <div class="faq-intro reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    
    <div class="faq-categories reveal">
      {%- for block in section.blocks -%}
        <button class="faq-category-btn" data-category="{{ block.settings.category | handleize }}">{{ block.settings.category }}</button>
      {%- endfor -%}
    </div>
    
    <div class="faq-list reveal">
      {%- for block in section.blocks -%}
        <details class="faq-item" data-category="{{ block.settings.category | handleize }}">
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-answer">
            <div class="rte">{{ block.settings.answer }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "category", "label": "Category", "default": "General" },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}