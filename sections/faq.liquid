<div id="FaqWrap" class="section--tight container">
<div class="faq-cats reveal">
<button type="button" class="faq-cat-btn is-active" data-cat="all">All</button>
<button type="button" class="faq-cat-btn" data-cat="shipping">Shipping</button>
<button type="button" class="faq-cat-btn" data-cat="products">Products</button>
<button type="button" class="faq-cat-btn" data-cat="care">Care</button>
