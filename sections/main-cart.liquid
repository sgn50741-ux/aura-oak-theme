<div class="container cart-page"><h1>Your Cart</h1>
{% if cart.item_count > 0 %}<form action="/cart" method="post">
{% for item in cart.items %}<div class="cart-row">
<a href="{{ item.url }}" class="cart-media">{% if item.image %}<img src="{{ item.image | image_url: width: 200 }}" alt="">{% endif %}</a>
<div><div class="info"><a href="{{ item.url }}">{{ item.product.title }}</a></div>{% unless item.variant.title == 'Default Title' %}<div class="variant">{{ item.variant.title }}</div>{% endunless %}</div>
<div>{{ item.price | money }}</div>
<div><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div>
<div>{{ item.final_line_price | money }}</div>
</div>{% endfor %}
<div class="cart-summary"><p class="subtotal">Subtotal: {{ cart.total_price | money }}</p><button type="submit" name="update" class="btn btn-ghost">Update cart</button><button type="submit" name="checkout" class="btn btn-primary">Checkout</button></div>
</form>{% else %}<div class="page-simple" style="margin:60px auto"><h1 style="font-size:2rem">Your cart is empty.</h1><p>Light something beautiful.</p><a href="/collections/all" class="btn btn-primary">Shop the collection</a></div>{% endif %}</div>
{% schema %}{"name":"Cart"}{% endschema %}