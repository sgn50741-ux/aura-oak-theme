<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="product-grid">
      {%- assign handles = section.settings.handles | split: ',' -%}
      {%- for handle in handles -%}
        {%- assign handle = handle | strip -%}
        {%- if handle != blank -%}
          {%- assign p = all_products[handle] -%}
          {%- if p != blank -%}
            {% render 'product-card', card_product: p %}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="text-center" style="margin-top:48px">
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="btn btn--ghost">{{ section.settings.view_all_label }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The ones that linger." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Our most-loved fragrances, chosen again and again by the people who live with them." },
    { "type": "textarea", "id": "handles", "label": "Product handles (comma-separated)", "default": "santal-noir-soy-candle,amber-oakmoss-soy-candle,terra-ceramic-reed-diffuser,discovery-set-six-mini-candles" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all products" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}