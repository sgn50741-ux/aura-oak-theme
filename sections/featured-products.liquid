<section class="section"><div class="container">
<div class="section-head reveal"><span class="eyebrow">Bestsellers</span><h2>The ones that linger.</h2><p>Our most-loved fragrances, chosen again and again by the people who live with them.</p></div>
<div class="product-grid stagger">{% assign col = collections[section.settings.collection] | default: collections.all %}{% for product in col.products limit: section.settings.limit %}{% render 'product-card', card_product: product %}{% endfor %}</div>
<div style="text-align:center;margin-top:48px"><a href="/collections/{{ section.settings.collection | default: 'all' }}" class="btn btn-ghost">{{ section.settings.view_all_label }}</a></div>
</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Limit","min":4,"max":12,"step":1,"default":8},{"type":"text","id":"view_all_label","label":"View all label","default":"View all products"}],"presets":[{"name":"Featured products","settings":{"collection":"all"}}]}{% endschema %}