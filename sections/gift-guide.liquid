<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Gift guide</span>
      <h2>Thoughtful gifts for every occasion.</h2>
    </div>
    
    <div class="gift-categories stagger">
      <div class="gift-category">
        {%- if section.settings.image_url_1 != blank -%}
          <div class="gift-category-bg" style="background-image:url('{{ section.settings.image_url_1 }}')"></div>
        {%- endif -%}
        <div class="gift-category-content">
          <h3>{{ section.settings.title_1 | default: 'For the Host' }}</h3>
          <p>{{ section.settings.desc_1 | default: 'Candles, diffusers, and room sprays for the friend who loves to entertain.' }}</p>
          <a href="{{ section.settings.link_1 | default: '/collections/gift-ideas' }}" class="btn btn--ghost" style="margin-top:16px;background:rgba(250,246,240,.9);color:var(--ink)">Shop now</a>
        </div>
      </div>
      <div class="gift-category">
        {%- if section.settings.image_url_2 != blank -%}
          <div class="gift-category-bg" style="background-image:url('{{ section.settings.image_url_2 }}')"></div>
        {%- endif -%}
        <div class="gift-category-content">
          <h3>{{ section.settings.title_2 | default: 'For the Ritualist' }}</h3>
          <p>{{ section.settings.desc_2 | default: 'Discovery sets and care kits for the one who savors the small moments.' }}</p>
          <a href="{{ section.settings.link_2 | default: '/collections/gift-ideas' }}" class="btn btn--ghost" style="margin-top:16px;background:rgba(250,246,240,.9);color:var(--ink)">Shop now</a>
        </div>
      </div>
      <div class="gift-category">
        {%- if section.settings.image_url_3 != blank -%}
          <div class="gift-category-bg" style="background-image:url('{{ section.settings.image_url_3 }}')"></div>
        {%- endif -%}
        <div class="gift-category-content">
          <h3>{{ section.settings.title_3 | default: 'For the New Home' }}</h3>
          <p>{{ section.settings.desc_3 | default: 'Housewarming sets and signature scents to make a new space feel like home.' }}</p>
          <a href="{{ section.settings.link_3 | default: '/collections/gift-ideas' }}" class="btn btn--ghost" style="margin-top:16px;background:rgba(250,246,240,.9);color:var(--ink)">Shop now</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    { "type": "text", "id": "title_1", "label": "Category 1 title", "default": "For the Host" },
    { "type": "textarea", "id": "desc_1", "label": "Category 1 description", "default": "Candles, diffusers, and room sprays for the friend who loves to entertain." },
    { "type": "url", "id": "link_1", "label": "Category 1 link" },
    { "type": "text", "id": "image_url_1", "label": "Category 1 image URL" },
    { "type": "text", "id": "title_2", "label": "Category 2 title", "default": "For the Ritualist" },
    { "type": "textarea", "id": "desc_2", "label": "Category 2 description", "default": "Discovery sets and care kits for the one who savors the small moments." },
    { "type": "url", "id": "link_2", "label": "Category 2 link" },
    { "type": "text", "id": "image_url_2", "label": "Category 2 image URL" },
    { "type": "text", "id": "title_3", "label": "Category 3 title", "default": "For the New Home" },
    { "type": "textarea", "id": "desc_3", "label": "Category 3 description", "default": "Housewarming sets and signature scents to make a new space feel like home." },
    { "type": "url", "id": "link_3", "label": "Category 3 link" },
    { "type": "text", "id": "image_url_3", "label": "Category 3 image URL" }
  ],
  "presets": [{ "name": "Gift Guide" }]
}
{% endschema %}