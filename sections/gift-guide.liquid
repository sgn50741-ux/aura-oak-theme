<section class="section">
  <div class="container">
    <div class="gift-intro reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="lead">{{ section.settings.intro }}</p>
    </div>
    
    <div class="gift-categories reveal">
      {%- for i in (1..3) -%}
        {%- assign title_key = 'category_title_' | append: i -%}
        {%- assign desc_key = 'category_desc_' | append: i -%}
        {%- assign link_key = 'category_link_' | append: i -%}
        {%- assign title = section.settings[title_key] -%}
        {%- assign desc = section.settings[desc_key] -%}
        {%- assign link = section.settings[link_key] -%}
        {%- if title != blank -%}
          <div class="gift-category">
            <h3>{{ title }}</h3>
            <p>{{ desc }}</p>
            <a href="{{ link }}" class="btn btn--ghost">Shop now</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift Guide" },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "text", "id": "category_title_1", "label": "Category 1 title", "default": "For the Homebody" },
    { "type": "textarea", "id": "category_desc_1", "label": "Category 1 description" },
    { "type": "url", "id": "category_link_1", "label": "Category 1 link" },
    { "type": "text", "id": "category_title_2", "label": "Category 2 title", "default": "For the Host" },
    { "type": "textarea", "id": "category_desc_2", "label": "Category 2 description" },
    { "type": "url", "id": "category_link_2", "label": "Category 2 link" },
    { "type": "text", "id": "category_title_3", "label": "Category 3 title", "default": "Luxury Gifts" },
    { "type": "textarea", "id": "category_desc_3", "label": "Category 3 description" },
    { "type": "url", "id": "category_link_3", "label": "Category 3 link" }
  ],
  "presets": [{ "name": "Gift Guide" }]
}
{% endschema %}