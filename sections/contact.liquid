<section class="content-block">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info reveal">
        <div class="contact-block">
          <h4>Studio</h4>
          <p>1234 Burnside Street<br>Portland, OR 97209<br>United States</p>
        </div>
        <div class="contact-block">
          <h4>Email</h4>
          <p>hello@auraandoak.com<br>wholesale@auraandoak.com</p>
        </div>
        <div class="contact-block">
          <h4>Hours</h4>
          <p>Monday – Friday: 9am – 6pm PST<br>Saturday: 10am – 4pm PST<br>Sunday: Closed</p>
        </div>
        <div class="contact-block">
          <h4>Follow us</h4>
          <p><a href="#">Instagram</a> · <a href="#">Pinterest</a> · <a href="#">TikTok</a></p>
        </div>
      </div>
      <div class="reveal delay-1">
        <form class="contact-form" method="post" action="/contact">
          <input type="hidden" name="form_type" value="contact">
          <input type="text" name="contact[name]" placeholder="Your name" required>
          <input type="email" name="contact[email]" placeholder="Your email" required>
          <input type="text" name="contact[subject]" placeholder="Subject">
          <textarea name="contact[body]" placeholder="Your message" required></textarea>
          <button type="submit" class="btn btn--primary btn--full">Send message</button>
        </form>
      </div>
    </div>
  </div>
</section>
{% schema %}{ "name": "Contact" }{% endschema %}