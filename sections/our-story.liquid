<section class="our-story-section">
  <div class="container">
    <div class="our-story-grid">
      <div class="our-story-image reveal">
        {%- if section.settings.image_url != blank -%}
          <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading }}" loading="lazy">
        {%- elsif section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}" loading="lazy">
        {%- endif -%}
      </div>
      <div class="reveal delay-1">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 style="font-family:var(--serif);font-size:clamp(2rem,4vw,3rem);margin:16px 0 24px;font-weight:300">{{ section.settings.heading }}</h2>
        <p style="color:var(--ink-soft)">{{ section.settings.body }}</p>
      </div>
    </div>
    
    <div class="timeline reveal">
      <div class="timeline-item">
        <div class="timeline-year">2017</div>
        <div class="timeline-content">
          <h3>The First Pour</h3>
          <p>Started in a converted garage in Portland with one candle — Amber & Oakmoss — and a belief that fragrance should be made with intention.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-year">2019</div>
        <div class="timeline-content">
          <h3>The Studio</h3>
          <p>Moved into our current studio space, a bright workshop where we still pour every candle by hand.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-year">2021</div>
        <div class="timeline-content">
          <h3>Ceramic Collaboration</h3>
          <p>Partnered with local ceramicists to create our signature hand-thrown vessels, designed to be refilled and reused.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-year">2024</div>
        <div class="timeline-content">
          <h3>Today</h3>
          <p>Still small, still hand-poured, still obsessed with the way a scent can make a room feel like home.</p>
        </div>
      </div>
    </div>
    
    <div class="values-grid stagger">
      <div class="value-card">
        <h4>Intentional</h4>
        <p>Every scent is composed with care, tested for months before release.</p>
      </div>
      <div class="value-card">
        <h4>Sustainable</h4>
        <p>100% soy wax, phthalate-free fragrances, refillable vessels.</p>
      </div>
      <div class="value-card">
        <h4>Handmade</h4>
        <p>Every candle poured, labeled, and packed by hand in our studio.</p>
      </div>
      <div class="value-card">
        <h4>Local</h4>
        <p>Partnering with Portland artisans and makers whenever possible.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our Story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From a garage to a practice." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "We started Aura & Oak in 2017 with a simple belief: the things we smell every day should be made with as much care as the things we eat and the things we read. Seven years later, we're still a small studio in Portland, still pouring by hand, still obsessed with the way a scent can make a room feel like home." },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "image_url", "label": "Or paste image URL" }
  ],
  "presets": [{ "name": "Our Story" }]
}
{% endschema %}