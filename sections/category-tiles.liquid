<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="tiles">
      {%- for i in (1..3) -%}
        {%- assign handle_key = 'collection_' | append: i -%}
        {%- assign img_key = 'image_url_' | append: i -%}
        {%- assign label_key = 'label_' | append: i -%}
        {%- assign handle = section.settings[handle_key] -%}
        {%- assign img = section.settings[img_key] -%}
        {%- assign label = section.settings[label_key] -%}
        {%- assign c = collections[handle] -%}
        {%- if handle != blank -%}
          <a href="{% if c %}{{ c.url }}{% else %}/collections/all/{{ handle | capitalize }}{% endif %}" class="tile reveal delay-{{ i }}">
            {%- if img != blank -%}
              <div class="tile-bg" style="background-image:url('{{ img }}')"></div>
            {%- endif -%}
            <div class="tile-body">
              <span class="eyebrow">Collection</span>
              <h3>{{ label | default: handle | capitalize }}</h3>
              <span class="tile-arrow">
                Explore
                <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three rituals, one philosophy." },
    { "type": "text", "id": "collection_1", "label": "Collection 1 handle", "default": "candles" },
    { "type": "text", "id": "label_1", "label": "Collection 1 label", "default": "Candles" },
    { "type": "text", "id": "image_url_1", "label": "Collection 1 image URL" },
    { "type": "text", "id": "collection_2", "label": "Collection 2 handle", "default": "diffusers" },
    { "type": "text", "id": "label_2", "label": "Collection 2 label", "default": "Diffusers" },
    { "type": "text", "id": "image_url_2", "label": "Collection 2 image URL" },
    { "type": "text", "id": "collection_3", "label": "Collection 3 handle", "default": "home-fragrance" },
    { "type": "text", "id": "label_3", "label": "Collection 3 label", "default": "Home Fragrance" },
    { "type": "text", "id": "image_url_3", "label": "Collection 3 image URL" }
  ],
  "presets": [{ "name": "Category tiles" }]
}
{% endschema %}