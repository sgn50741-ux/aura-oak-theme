<section class="section"><div class="container">
<div class="section-head reveal"><span class="eyebrow">Shop by collection</span><h2>Three rituals, one philosophy.</h2></div>
<div class="tiles stagger">{% for block in section.blocks %}<a href="/collections/{{ block.settings.collection_handle }}" class="tile" {{ block.shopify_attributes }}>
{% if block.settings.image_url != blank %}<div class="tile-bg" style="background-image:url('{{ block.settings.image_url }}')"></div>{% endif %}
<div class="tile-body"><span class="eyebrow">Collection</span><h3>{{ block.settings.label }}</h3><span class="tile-arrow">Explore <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div></a>{% endfor %}</div>
</div></section>
{% schema %}{"name":"Category tiles","blocks":[{"type":"tile","name":"Tile","settings":[{"type":"text","id":"collection_handle","label":"Collection handle"},{"type":"text","id":"label","label":"Label"},{"type":"text","id":"image_url","label":"Image URL"}]}],"presets":[{"name":"Category tiles","blocks":[{"type":"tile","settings":{"collection_handle":"candles","label":"Candles"}},{"type":"tile","settings":{"collection_handle":"diffusers","label":"Diffusers"}},{"type":"tile","settings":{"collection_handle":"home-fragrance","label":"Room Sprays & Incense"}}]}]}{% endschema %}