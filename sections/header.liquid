{%- if section.settings.announce != blank -%}
  <div class="announce">
    <div class="announce-track">
      <span>{{ section.settings.announce }}</span>
      <span>{{ section.settings.announce }}</span>
    </div>
  </div>
{%- endif -%}

<header class="site-header" data-header>
  <div class="container header-inner">
    <button class="menu-toggle" aria-label="Menu">
      <svg class="icon" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a href="{{ routes.root_url }}" class="logo">Aura <em>&</em> Oak</a>
    <nav class="nav nav--main" data-nav>
      <!-- SHOP mega menu -->
      <div class="nav-item has-mega" data-mega>
        <a href="/collections/all" class="nav-link">Shop <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="mega-menu">
          <div class="mega-inner">
            <div class="mega-col">
              <h5>Collections</h5>
              <ul>
                <li><a href="/collections/all">All Products</a></li>
                <li><a href="/collections/candles">Candles</a></li>
                <li><a href="/collections/diffusers">Diffusers</a></li>
                <li><a href="/collections/home-fragrance">Home Fragrance</a></li>
                <li><a href="/collections/gift-ideas">Gift Sets</a></li>
                <li><a href="/collections/accessories">Accessories</a></li>
              </ul>
            </div>
            <div class="mega-col">
              <h5>By Scent</h5>
              <ul>
                <li><a href="/collections/all/Woody">Woody</a></li>
                <li><a href="/collections/all/Warm">Warm & Spicy</a></li>
                <li><a href="/collections/all/Fresh">Fresh</a></li>
                <li><a href="/collections/all/Floral">Floral</a></li>
                <li><a href="/collections/all/Fruity">Fruity</a></li>
              </ul>
            </div>
            <div class="mega-col">
              <h5>Featured</h5>
              <ul>
                <li><a href="/collections/all/Bestseller">Bestsellers</a></li>
                <li><a href="/collections/all/New">New Arrivals</a></li>
                <li><a href="/collections/gift-ideas">Gift Guide</a></li>
              </ul>
            </div>
            <div class="mega-feature">
              <div class="mega-feature-img" style="background-image:url('https://images.unsplash.com/photo-1602874801007-aa24b6a6a1c8?w=600')"></div>
              <div class="mega-feature-body">
                <span class="eyebrow">New</span>
                <h4>Evening Ritual Set</h4>
                <p>A curated trio for slow evenings.</p>
                <a href="/products/evening-ritual-gift-set" class="mega-feature-link">Shop now →</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- STUDIO mega menu -->
      <div class="nav-item has-mega" data-mega>
        <a href="/pages/our-story" class="nav-link">Studio <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="mega-menu mega-menu--sm">
          <div class="mega-inner">
            <div class="mega-col">
              <h5>About</h5>
              <ul>
                <li><a href="/pages/our-story">Our Story</a></li>
                <li><a href="/pages/sustainability">Sustainability</a></li>
                <li><a href="/pages/wholesale">Wholesale</a></li>
              </ul>
            </div>
            <div class="mega-col">
              <h5>Journal</h5>
              <ul>
                <li><a href="/pages/journal">The Ritual Journal</a></li>
                <li><a href="/pages/lookbook">Lookbook</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- HELP mega menu -->
      <div class="nav-item has-mega" data-mega>
        <a href="/pages/faq" class="nav-link">Help <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="mega-menu mega-menu--sm">
          <div class="mega-inner">
            <div class="mega-col">
              <h5>Support</h5>
              <ul>
                <li><a href="/pages/shipping">Shipping & Returns</a></li>
                <li><a href="/pages/faq">FAQ</a></li>
                <li><a href="/pages/candle-care">Candle Care</a></li>
                <li><a href="/pages/contact">Contact Us</a></li>
              </ul>
            </div>
            <div class="mega-col">
              <h5>Your Account</h5>
              <ul>
                <li><a href="{{ routes.account_url }}">Sign in</a></li>
                <li><a href="{{ routes.account_register_url }}">Create account</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <a href="/pages/journal" class="nav-link">Journal</a>
      <a href="/pages/our-story" class="nav-link">Our Story</a>
    </nav>
    <div class="header-icons">
      <a href="/search" aria-label="Search">
        <svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </a>
      <a href="{{ routes.account_url }}" aria-label="Account">
        <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Cart">
        <svg class="icon" viewBox="0 0 24 24"><path d="M3 3h2l2.5 13h11l2-9H6"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
        <span class="cart-count" hidden data-cart-count>0</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-menu">
  <button class="mobile-menu-close" aria-label="Close">×</button>
  <a href="/collections/all">Shop All</a>
  <a href="/collections/candles">Candles</a>
  <a href="/collections/diffusers">Diffusers</a>
  <a href="/collections/home-fragrance">Home Fragrance</a>
  <a href="/collections/gift-ideas">Gifts</a>
  <a href="/pages/our-story">Our Story</a>
  <a href="/pages/journal">Journal</a>
  <a href="/pages/faq">FAQ</a>
  <a href="/pages/contact">Contact</a>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announce", "label": "Announcement", "default": "Complimentary shipping on orders over $75 ✦ Hand-poured in small batches ✦ 100% soy wax" }
  ]
}
{% endschema %}
