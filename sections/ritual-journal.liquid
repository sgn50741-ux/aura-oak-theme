<section class="section">
  <div class="container">
    <div class="journal-intro reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    
    <div class="journal-grid reveal">
      {%- for i in (1..3) -%}
        {%- assign title_key = 'article_title_' | append: i -%}
        {%- assign excerpt_key = 'article_excerpt_' | append: i -%}
        {%- assign link_key = 'article_link_' | append: i -%}
        {%- assign img_key = 'article_image_' | append: i -%}
        {%- assign title = section.settings[title_key] -%}
        {%- assign excerpt = section.settings[excerpt_key] -%}
        {%- assign link = section.settings[link_key] -%}
        {%- assign img = section.settings[img_key] -%}
        {%- if title != blank -%}
          <article class="journal-card">
            {%- if img != blank -%}
              <div class="journal-image">
                <img src="{{ img }}" alt="{{ title | escape }}" loading="lazy">
              </div>
            {%- endif -%}
            <div class="journal-content">
              <h3>{{ title }}</h3>
              <p>{{ excerpt }}</p>
              <a href="{{ link }}" class="journal-link">Read more →</a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ritual Journal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Ritual Journal" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "article_title_1", "label": "Article 1 title" },
    { "type": "textarea", "id": "article_excerpt_1", "label": "Article 1 excerpt" },
    { "type": "url", "id": "article_link_1", "label": "Article 1 link" },
    { "type": "text", "id": "article_image_1", "label": "Article 1 image URL" },
    { "type": "text", "id": "article_title_2", "label": "Article 2 title" },
    { "type": "textarea", "id": "article_excerpt_2", "label": "Article 2 excerpt" },
    { "type": "url", "id": "article_link_2", "label": "Article 2 link" },
    { "type": "text", "id": "article_image_2", "label": "Article 2 image URL" },
    { "type": "text", "id": "article_title_3", "label": "Article 3 title" },
    { "type": "textarea", "id": "article_excerpt_3", "label": "Article 3 excerpt" },
    { "type": "url", "id": "article_link_3", "label": "Article 3 link" },
    { "type": "text", "id": "article_image_3", "label": "Article 3 image URL" }
  ],
  "presets": [{ "name": "Ritual Journal" }]
}
{% endschema %}