
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="journal-grid stagger">
      {%- for i in (1..3) -%}
        {%- assign img_key = 'image_url_' | append: i -%}
        {%- assign cat_key = 'category_' | append: i -%}
        {%- assign title_key = 'title_' | append: i -%}
        {%- assign desc_key = 'description_' | append: i -%}
        {%- assign link_key = 'link_' | append: i -%}
        {%- assign img = section.settings[img_key] -%}
        {%- assign cat = section.settings[cat_key] -%}
        {%- assign title = section.settings[title_key] -%}
        {%- assign desc = section.settings[desc_key] -%}
        {%- assign link = section.settings[link_key] -%}
        {%- if title != blank -%}
          <a href="{{ link | default: '#' }}" class="journal-card reveal">
            <div class="journal-card-media">{%- if img != blank %}<img src="{{ img }}" alt="{{ title | escape }}" loading="lazy">{%- endif -%}</div>
            <div class="journal-card-cat">{{ cat }}</div>
            <h3>{{ title }}</h3>
            <p>{{ desc }}</p>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}{"name":"Ritual journal","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The journal"},
{"type":"text","id":"heading","label":"Heading","default":"Notes from the studio."},
{"type":"textarea","id":"subheading","label":"Subheading","default":"Essays, rituals, and the occasional recipe."},
{"type":"text","id":"image_url_1","label":"Image 1 URL"},{"type":"text","id":"category_1","label":"Category 1","default":"Ritual"},
{"type":"text","id":"title_1","label":"Title 1","default":"The art of the evening wind-down"},
{"type":"textarea","id":"description_1","label":"Description 1","default":"How a single candle can turn a routine into a ritual."},
{"type":"url","id":"link_1","label":"Link 1"},
{"type":"text","id":"image_url_2","label":"Image 2 URL"},{"type":"text","id":"category_2","label":"Category 2","default":"Interview"},
{"type":"text","id":"title_2","label":"Title 2","default":"In the studio with James Okabe"},
{"type":"textarea","id":"description_2","label":"Description 2","default":"The ceramicist behind our signature vessels."},
{"type":"url","id":"link_2","label":"Link 2"},
{"type":"text","id":"image_url_3","label":"Image 3 URL"},{"type":"text","id":"category_3","label":"Category 3","default":"Guide"},
{"type":"text","id":"title_3","label":"Title 3","default":"How to choose a scent for every room"},
{"type":"textarea","id":"description_3","label":"Description 3","default":"A room-by-room guide to pairing fragrance with function."},
{"type":"url","id":"link_3","label":"Link 3"}
],"presets":[{"name":"Ritual journal"}]}{% endschema %}
