<div class="container section"><div class="page-hero" style="padding-top:0;padding-bottom:40px"><h1>Search</h1>
<form action="/search" method="get" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search scents, products..."><button class="btn btn-primary">Search</button></form>
</div>
{% if search.performed %}<h2 style="text-align:center;font-family:var(--serif);font-weight:300;margin-bottom:32px">{{ search.results_count }} results for "{{ search.terms }}"</h2>
<div class="product-grid stagger">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% endif %}{% endfor %}</div>{% endif %}</div>
{% schema %}{"name":"Search"}{% endschema %}