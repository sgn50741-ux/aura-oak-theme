<div class="container section">
  <div class="text-center reveal" style="max-width:640px;margin:0 auto 48px">
    <span class="eyebrow">Search</span>
    <h1 style="font-family:var(--serif);font-size:clamp(2rem,5vw,3.5rem);margin:16px 0">What are you looking for?</h1>
    <form action="/search" method="get" style="display:flex;gap:8px;max-width:480px;margin:24px auto 0">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search scents, products..." style="flex:1;padding:16px 20px;border:1px solid var(--line);border-radius:var(--r-sm);background:transparent">
      <button class="btn btn--primary">Search</button>
    </form>
  </div>
  {%- if search.performed -%}
    <p class="text-center" style="margin-bottom:32px">{{ search.results_count }} results for "{{ search.terms }}"</p>
    <div class="product-grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', card_product: item %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}{ "name": "Search page" }{% endschema %}