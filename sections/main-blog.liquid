<div class="container section"><div class="page-hero" style="padding-top:0;padding-bottom:40px"><h1>{{ blog.title }}</h1></div>
{% paginate blog.articles by 9 %}<div class="article-list stagger">{% for article in blog.articles %}<a href="{{ article.url }}" class="article-card">
{% if article.image %}<div class="article-card-media"><img src="{{ article.image | image_url: width: 800 }}" alt="" loading="lazy"></div>{% endif %}
<div class="date">{{ article.published_at | date: '%B %Y' }}</div><h3>{{ article.title }}</h3><p class="excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p></a>{% endfor %}</div>
{% if paginate.pages > 1 %}<nav class="pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">←</a>{% endif %}{% if paginate.next %}<a href="{{ paginate.next.url }}">→</a>{% endif %}</nav>{% endif %}{% endpaginate %}</div>
{% schema %}{"name":"Blog"}{% endschema %}