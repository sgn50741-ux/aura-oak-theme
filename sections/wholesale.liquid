<section class="content-block">
  <div class="container">
    <div class="split">
      <div class="split-content reveal">
        <h2>Partner with us</h2>
        <p>We work with select boutiques, gift shops, and lifestyle stores that share our commitment to quality and craftsmanship. Minimum order: $500. Net 30 terms for approved accounts.</p>
        <p>Our retail partners receive dedicated support, marketing materials, and exclusive access to limited editions.</p>
        <a href="/pages/contact" class="btn btn--primary" style="margin-top:24px">Apply for wholesale</a>
      </div>
      <div class="split-media reveal delay-1">
        <img src="https://images.unsplash.com/photo-1602874801007-aa24b6d6f0c8?w=800" alt="Wholesale partnership" loading="lazy">
      </div>
    </div>
    <div class="values-grid stagger" style="margin-top:80px">
      <div class="value-card">
        <h3>Curated selection</h3>
        <p>Choose from our full collection of candles, diffusers, and home fragrances. We'll help you select the best scents for your market.</p>
      </div>
      <div class="value-card">
        <h3>Marketing support</h3>
        <p>Receive product photography, display materials, and social media assets to help promote Aura & Oak in your store.</p>
      </div>
      <div class="value-card">
        <h3>Exclusive access</h3>
        <p>Get first access to limited editions, seasonal releases, and new product launches before they're available to the public.</p>
      </div>
      <div class="value-card">
        <h3>Dedicated support</h3>
        <p>Your dedicated account manager is available to answer questions, process orders, and ensure your success.</p>
      </div>
    </div>
  </div>
</section>
{% schema %}{ "name": "Wholesale" }{% endschema %}