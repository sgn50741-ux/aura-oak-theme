<section class="section">
  <div class="container">
    <div class="wholesale-intro reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="lead">{{ section.settings.intro }}</p>
    </div>
    
    <div class="benefits-grid reveal">
      {%- for i in (1..4) -%}
        {%- assign title_key = 'benefit_title_' | append: i -%}
        {%- assign text_key = 'benefit_text_' | append: i -%}
        {%- assign title = section.settings[title_key] -%}
        {%- assign text = section.settings[text_key] -%}
        {%- if title != blank -%}
          <div class="benefit-card">
            <h3>{{ title }}</h3>
            <p>{{ text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <div class="wholesale-cta reveal">
      <h3>{{ section.settings.cta_heading }}</h3>
      <p>{{ section.settings.cta_text }}</p>
      <a href="mailto:{{ section.settings.cta_email }}" class="btn btn--primary">{{ section.settings.cta_button }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wholesale Partnerships" },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "text", "id": "benefit_title_1", "label": "Benefit 1 title", "default": "Competitive Margins" },
    { "type": "textarea", "id": "benefit_text_1", "label": "Benefit 1 text" },
    { "type": "text", "id": "benefit_title_2", "label": "Benefit 2 title", "default": "Minimum Orders" },
    { "type": "textarea", "id": "benefit_text_2", "label": "Benefit 2 text" },
    { "type": "text", "id": "benefit_title_3", "label": "Benefit 3 title", "default": "Fast Shipping" },
    { "type": "textarea", "id": "benefit_text_3", "label": "Benefit 3 text" },
    { "type": "text", "id": "benefit_title_4", "label": "Benefit 4 title", "default": "Marketing Support" },
    { "type": "textarea", "id": "benefit_text_4", "label": "Benefit 4 text" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Ready to partner?" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text" },
    { "type": "text", "id": "cta_email", "label": "CTA email", "default": "wholesale@auraandoak.com" },
    { "type": "text", "id": "cta_button", "label": "CTA button", "default": "Apply now" }
  ],
  "presets": [{ "name": "Wholesale" }]
}
{% endschema %}