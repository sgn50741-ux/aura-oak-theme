<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Wholesale</span>
      <h2>Bring Aura & Oak to your space.</h2>
      <p>We partner with select retailers who share our commitment to quality, craftsmanship, and mindful living.</p>
    </div>
    
    <div class="wholesale-benefits stagger">
      <div class="benefit-card">
        <h4>Minimum Order</h4>
        <p>$500 initial order, $250 reorders. Flexible terms for established accounts.</p>
      </div>
      <div class="benefit-card">
        <h4>Exclusive Scents</h4>
        <p>Access to wholesale-exclusive fragrances and limited editions not available in our retail shop.</p>
      </div>
      <div class="benefit-card">
        <h4>Marketing Support</h4>
        <p>Comprehensive product training, display materials, and co-op marketing opportunities.</p>
      </div>
      <div class="benefit-card">
        <h4>Net 30 Terms</h4>
        <p>Standard net 30 payment terms for approved accounts. Quick pay discount available.</p>
      </div>
      <div class="benefit-card">
        <h4>Free Shipping</h4>
        <p>Complimentary shipping on all wholesale orders over $500 within the continental US.</p>
      </div>
      <div class="benefit-card">
        <h4>Dedicated Support</h4>
        <p>Personal account manager and priority customer service for all wholesale partners.</p>
      </div>
    </div>
    
    <div class="text-center reveal" style="margin-top:64px">
      <h3 style="font-family:var(--serif);font-size:24px;margin-bottom:16px">Ready to apply?</h3>
      <p style="color:var(--ink-soft);margin-bottom:24px">Email us at wholesale@auraandoak.com with your business information and we'll be in touch within 2 business days.</p>
      <a href="mailto:wholesale@auraandoak.com" class="btn btn--primary btn--large">Apply for wholesale</a>
    </div>
  </div>
</section>

