<section class="section" style="background:var(--cream2)"><div class="container">
<div class="section-head reveal"><span class="eyebrow">The Ritual Journal</span><h2>Slow reads for slow evenings.</h2></div>
<div class="j-grid stagger">{% for block in section.blocks %}<a href="{{ block.settings.url }}" class="j-card" {{ block.shopify_attributes }}>
{% if block.settings.image_url != blank %}<div class="j-card-media"><img src="{{ block.settings.image_url }}" alt="" loading="lazy"></div>{% endif %}
<div class="j-date">{{ block.settings.date }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.excerpt }}</p></a>{% endfor %}</div>
</div></section>
{% schema %}{"name":"Journal preview","blocks":[{"type":"article","name":"Article","settings":[{"type":"text","id":"date","label":"Date"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"excerpt","label":"Excerpt"},{"type":"url","id":"url","label":"URL"},{"type":"text","id":"image_url","label":"Image URL"}]}],"presets":[{"name":"Journal preview","blocks":[{"type":"article","settings":{"date":"March 2026","title":"The art of the slow evening","excerpt":"How five minutes of ritual can recalibrate an entire day.","url":"/pages/journal"}},{"type":"article","settings":{"date":"February 2026","title":"Why soy wax matters","excerpt":"A deep dive into the wax we choose, and the ones we don't.","url":"/pages/sustainability"}},{"type":"article","settings":{"date":"January 2026","title":"Candle care, reconsidered","excerpt":"Everything you were taught about burning candles is probably wrong.","url":"/pages/candle-care"}}]}]}{% endschema %}