
<div class="page-hero">
  <div class="page-hero-content reveal">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The quiet ritual of home." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A story of craft, care, and the pursuit of scent." }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
