<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="reveal">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="reveal delay-1">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}