<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{{ content_for_header }}
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
{{ 'aura.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ template.name }}">
<div class="announce">Complimentary shipping on orders over $75 &#10022; Hand-poured in small batches &#10022; 100% soy wax</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">Aura <em>&amp;</em> Oak</a>
    <nav class="nav">
      <div class="nav-item"><a href="/collections/all" class="nav-link">Shop</a>
        <div class="mega"><div class="mega-inner">
          <div class="mega-col"><h5 class="mega-title">Collections</h5><a href="/collections/all">All Products</a><a href="/collections/candles">Candles</a><a href="/collections/diffusers">Diffusers</a><a href="/collections/home-fragrance">Home Fragrance</a></div>
          <div class="mega-col"><h5 class="mega-title">By Scent</h5><a href="/collections/all/woody">Woody</a><a href="/collections/all/warm">Warm</a><a href="/collections/all/fresh">Fresh</a></div>
        </div></div>
      </div>
      <div class="nav-item"><a href="/pages/our-story" class="nav-link">Studio</a>
        <div class="mega mega-sm"><div class="mega-inner">
          <div class="mega-col"><a href="/pages/our-story">Our Story</a><a href="/pages/sustainability">Sustainability</a></div>
          <div class="mega-col"><a href="/pages/journal">Journal</a><a href="/pages/lookbook">Lookbook</a></div>
        </div></div>
      </div>
      <div class="nav-item"><a href="/pages/faq" class="nav-link">Help</a>
        <div class="mega mega-sm"><div class="mega-inner">
          <div class="mega-col"><a href="/pages/shipping">Shipping</a><a href="/pages/faq">FAQ</a><a href="/pages/contact">Contact</a></div>
        </div></div>
      </div>
    </nav>
    <div class="header-icons">
      <a href="/search" class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></a>
      <a href="/cart" class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h2l2.5 13h11l2-9H6"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg><span class="cart-count">{{ cart.item_count }}</span></a>
    </div>
  </div>
</header>
<main>{{ content_for_layout }}</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div><a href="/" class="logo">Aura <em>&amp;</em> Oak</a><p>Hand-poured in Portland.</p></div>
    <div><h5>Shop</h5><a href="/collections/candles">Candles</a><a href="/collections/diffusers">Diffusers</a></div>
    <div><h5>Studio</h5><a href="/pages/our-story">Our Story</a><a href="/pages/journal">Journal</a></div>
    <div><h5>Help</h5><a href="/pages/faq">FAQ</a><a href="/pages/contact">Contact</a></div>
  </div>
</footer>
{{ 'aura.js' | asset_url | script_tag }}
</body>
</html>