<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | escape }}">
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'aura.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ template.name }}">
  <script>document.body.style.opacity='0';window.addEventListener('load',()=>{document.body.style.transition='opacity 0.6s ease';document.body.style.opacity='1';});</script>
  {% section 'header' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% section 'footer' %}
  {% section 'cart-drawer' %}
  <script>window.AURA={moneyFormat:{{shop.money_format|json}}};</script>
  {{ 'aura.js' | asset_url | script_tag }}
</body>
</html>