<script>
window.AURA = { moneyFormat: {{ shop.money_format | json }}, freeShipThreshold: 500000 };
(function(){
  var $ = function(s,r){ return (r||document).querySelector(s) };
  var $$ = function(s,r){ return Array.prototype.slice.call((r||document).querySelectorAll(s)) };
  document.addEventListener('DOMContentLoaded', function(){
    requestAnimationFrame(function(){ document.body.classList.add('loaded'); });
    initReveal(); initHeader(); initMega(); initMobile(); initCart(); initPDP(); initFAQ(); initNews(); initMarquee();
  });

  function initReveal(){
    var els = $$('.reveal,.reveal-left,.reveal-right,.reveal-scale,.stagger');
    if(!('IntersectionObserver' in window)){ els.forEach(function(e){e.classList.add('in');}); return; }
    var io = new IntersectionObserver(function(en){ en.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, {threshold:.12,rootMargin:'0px 0px -40px 0px'});
    els.forEach(function(e){ io.observe(e); });
  }

  function initHeader(){
    var h = $('.site-header'); if(!h) return;
    var f = function(){ h.classList.toggle('is-scrolled', window.scrollY > 8); };
    window.addEventListener('scroll', f, {passive:true}); f();
  }

  // MEGA MENU: click to toggle (better for touch + guarantees visibility)
  function initMega(){
    var items = $$('.nav-item[data-mega]');
    items.forEach(function(item){
      var link = item.querySelector('.nav-link');
      var mega = item.querySelector('.mega');
      if(!mega) return;
      // Hover works on desktop; click toggles as fallback
      link.addEventListener('click', function(e){
        // only intercept on touch/mobile OR if mega is closed
        if(window.matchMedia('(max-width:900px)').matches || !item.classList.contains('is-open')){
          e.preventDefault();
          // close others
          items.forEach(function(it){ if(it !== item) it.classList.remove('is-open'); });
          item.classList.toggle('is-open');
        }
      });
    });
    // Close on outside click
    document.addEventListener('click', function(e){
      if(!e.target.closest('.nav-item[data-mega]')){
        items.forEach(function(it){ it.classList.remove('is-open'); });
      }
    });
    // Close on ESC
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape') items.forEach(function(it){ it.classList.remove('is-open'); });
    });
  }

  function initMobile(){
    var m = $('.mobile-menu'); if(!m) return;
    var open = function(){ m.classList.add('is-open'); document.body.classList.add('no-scroll'); };
    var close = function(){ m.classList.remove('is-open'); document.body.classList.remove('no-scroll'); };
    var t = $('.menu-toggle'); if(t) t.addEventListener('click', open);
    $$('.mm-close', m).forEach(function(b){ b.addEventListener('click', close); });
    $$('.mm-panel a,.mm-link', m).forEach(function(a){ a.addEventListener('click', close); });
    $$('.mm-acc > button', m).forEach(function(b){ b.addEventListener('click', function(){ b.parentElement.classList.toggle('is-open'); }); });
  }

  var drawer;
  function initCart(){
    drawer = $('#CartDrawer'); if(!drawer) return;
    $$('[data-cart-open]').forEach(function(el){ el.addEventListener('click', function(e){ e.preventDefault(); openD(); refresh(); }); });
    $$('[data-cart-close]', drawer).forEach(function(el){ el.addEventListener('click', closeD); });
    refresh();
  }
  function openD(){ drawer.classList.add('is-open'); drawer.setAttribute('aria-hidden','false'); document.body.classList.add('no-scroll'); }
  function closeD(){ drawer.classList.remove('is-open'); drawer.setAttribute('aria-hidden','true'); document.body.classList.remove('no-scroll'); }
  function refresh(){ fetch('/cart.js',{cache:'no-store'}).then(function(r){return r.json();}).then(render).catch(function(){}); }
  function money(c){
    var v = Math.round(c/100);
    return 'Rs ' + v.toLocaleString('en-IN');
  }
  function render(cart){
    $$('.cart-count').forEach(function(el){ el.textContent = cart.item_count; el.classList.toggle('is-hidden', cart.item_count === 0); });
    var hc = $('.cart-head-count'); if(hc) hc.textContent = cart.item_count ? '('+cart.item_count+')' : '';
    var items = $('#CartItems');
    if(items){
      if(!cart.items.length){
        items.innerHTML = '<div class="cart-empty"><p class="serif">Your cart is empty.</p><p>Light something beautiful.</p><a class="btn btn-primary" href="/collections/all">Shop the collection</a></div>';
      } else {
        items.innerHTML = cart.items.map(function(it){
          return '<div class="cart-item" data-key="'+it.key+'">' +
            '<a class="cart-item-media" href="'+it.url+'">'+(it.image?'<img src="'+it.image+'" alt="">':'<span class="cart-item-ph">A&O</span>')+'</a>' +
            '<div><a class="cart-item-title" href="'+it.url+'">'+(it.product_title||it.title)+'</a>' +
            ((it.variant_title && it.variant_title !== 'Default Title') ? '<div class="cart-item-variant">'+it.variant_title+'</div>' : '') +
            '<div class="cart-item-qty"><button type="button" data-qty="-1">−</button><span>'+it.quantity+'</span><button type="button" data-qty="1">+</button></div></div>' +
            '<div class="cart-item-right"><div class="cart-item-price">'+money(it.final_line_price||it.line_price)+'</div><button class="cart-item-remove" type="button" data-remove>Remove</button></div></div>';
        }).join('');
        $$('.cart-item', items).forEach(function(row){
          var key = row.getAttribute('data-key');
          var item = cart.items.filter(function(i){return i.key === key;})[0];
          $$('[data-qty]', row).forEach(function(b){ b.addEventListener('click', function(){ change(key, item.quantity + parseInt(b.getAttribute('data-qty'),10)); }); });
          var rm = $('[data-remove]', row); if(rm) rm.addEventListener('click', function(){ change(key,0); });
        });
      }
    }
    var th = window.AURA.freeShipThreshold || 500000;
    var rem = th - cart.total_price;
    var pt = $('.cart-progress-text'), bar = $('.cart-progress-fill');
    if(pt) pt.innerHTML = rem > 0 ? 'Add <strong>'+money(rem)+'</strong> more for complimentary shipping' : '<span style="color:var(--sage)">✓ Complimentary shipping unlocked</span>';
    if(bar) bar.style.width = Math.min(100, cart.total_price/th*100) + '%';
    var sub = $('#CartSubtotal'); if(sub) sub.textContent = money(cart.total_price);
  }
  function change(key, qty){
    fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:key,quantity:qty})}).then(function(r){return r.json();}).then(render).catch(function(){});
  }
  function add(id, qty){
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,quantity:qty||1})}).then(function(r){ if(!r.ok) throw 0; return r.json(); }).then(function(){ refresh(); openD(); toast('Added to your cart'); }).catch(function(){ toast('Sorry, that could not be added.'); });
  }
  document.addEventListener('click', function(e){
    var b = e.target.closest('[data-add-to-cart]');
    if(b){ e.preventDefault(); add(parseInt(b.getAttribute('data-add-to-cart'),10), 1); }
  });

  function initPDP(){
    var form = $('#ProductForm'); if(!form) return;
    var j = $('#ProductJSON'); if(!j) return;
    var p; try{ p = JSON.parse(j.textContent); }catch(e){ return; }
    var state = {}; p.options.forEach(function(o,i){ state[o] = p.variants[0].options[i]; });
    function cur(){
      for(var v=0; v<p.variants.length; v++){
        var va = p.variants[v], ok = true;
        for(var i=0; i<p.options.length; i++){ if(va.options[i] !== state[p.options[i]]){ ok=false; break; } }
        if(ok) return va;
      }
      return null;
    }
    function renderP(){
      $$('.pdp-option-pill', form).forEach(function(b){ b.classList.toggle('is-selected', state[b.getAttribute('data-option')] === b.getAttribute('data-value')); });
      var v = cur(); var a = $('#PdpAdd'), pr = $('#PdpPrice'), sel = $('#VariantSelect');
      if(v){
        if(pr) pr.innerHTML = money(v.price) + ((v.compare_at_price && v.compare_at_price > v.price) ? ' <span class="compare">'+money(v.compare_at_price)+'</span>' : '');
        if(sel) sel.value = v.id;
        if(a){ a.disabled = !v.available; a.textContent = v.available ? 'Add to cart' : 'Sold out'; }
      } else if(a){ a.disabled = true; a.textContent = 'Unavailable'; }
    }
    $$('.pdp-option-pill', form).forEach(function(b){ b.addEventListener('click', function(){ state[b.getAttribute('data-option')] = b.getAttribute('data-value'); renderP(); }); });
    var mi=$('#QtyMinus'), pl=$('#QtyPlus'), qi=$('#QtyInput');
    if(mi&&pl&&qi){ mi.addEventListener('click',function(){qi.value=Math.max(1,parseInt(qi.value||'1',10)-1);}); pl.addEventListener('click',function(){qi.value=parseInt(qi.value||'1',10)+1;}); }
    form.addEventListener('submit', function(e){ e.preventDefault(); var v = cur(); if(v && v.available) add(v.id, parseInt((qi&&qi.value)||'1',10)); });
    var main = $('#PdpMainImg');
    $$('.pdp-thumb').forEach(function(t){ t.addEventListener('click', function(){ if(main) main.src = t.getAttribute('data-src'); $$('.pdp-thumb').forEach(function(x){x.classList.toggle('is-active', x===t);}); }); });
    renderP();
  }

  function initFAQ(){
    var w = $('#FaqWrap'); if(!w) return;
    $$('.faq-cat-btn', w).forEach(function(b){ b.addEventListener('click', function(){
      var c = b.getAttribute('data-cat');
      $$('.faq-cat-btn', w).forEach(function(x){ x.classList.toggle('is-active', x===b); });
      $$('.faq-item', w).forEach(function(i){ i.classList.toggle('is-hidden', c !== 'all' && i.getAttribute('data-cat') !== c); });
    }); });
  }

  function initNews(){
    $$('form[data-newsletter]').forEach(function(f){ f.addEventListener('submit', function(e){
      e.preventDefault();
      var em = $('input[type="email"]', f); if(!em || !em.value) return;
      fetch('/contact',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'form_type=newsletter&contact%5Bemail%5D='+encodeURIComponent(em.value)+'&contact%5Btags%5D=newsletter'}).then(function(){ f.innerHTML = '<p class="newsletter-success">Welcome to the ritual. Use code RITUAL10 for 10% off your first order.</p>'; }).catch(function(){ toast('Something went wrong. Please try again.'); });
    }); });
  }

  function initMarquee(){ $$('.marquee-track').forEach(function(t){ t.innerHTML += t.innerHTML; }); }

  var tEl;
  function toast(m){
    if(!tEl){ tEl = document.createElement('div'); tEl.className = 'toast'; document.body.appendChild(tEl); }
    tEl.textContent = m; tEl.classList.add('is-shown');
    clearTimeout(toast._t); toast._t = setTimeout(function(){ tEl.classList.remove('is-shown'); }, 2600);
  }
})();
</script>
</body></html>